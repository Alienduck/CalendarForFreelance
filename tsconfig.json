{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",          // ou "react-jsxdev" en dev
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist/",
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["backend/**/*", "dist/server.js"],
  "exclude": ["**/*.test.ts"]
}
